# Telemetry deployment settings for compose.yml (docs/operations.md).
# Copy to telemetry/.env and adjust. This file holds NO secrets: passwords are
# files in TELEMETRY_SECRETS_DIR (see secrets/README.md). Empty values mean
# "built-in default".

# --- Required -----------------------------------------------------------------
# Immutable release image: a sha-<commit> tag, ideally pinned by digest too.
# Never a moving tag such as latest.
COLLECTOR_IMAGE=ghcr.io/ryyanmapes/lean4-wasm-in-browser-telemetry:sha-0000000@sha256:<digest>
# PostgreSQL data volume (external). Existing deployment (root project):
# root_telemetry_postgres. New install: docker volume create telemetry_postgres.
POSTGRES_VOLUME=root_telemetry_postgres

# --- Database ---------------------------------------------------------------------
# Pinned image; keep the major version of the existing data directory (17).
POSTGRES_IMAGE=postgres:17.10-alpine3.24
# Bootstrap superuser and database. Must match the existing volume.
POSTGRES_DB=lean_telemetry
POSTGRES_USER=lean_telemetry

# --- Secrets ------------------------------------------------------------------------
TELEMETRY_SECRETS_DIR=./secrets
# Group that owns the secret files (mode 0440); every consuming container joins it.
TELEMETRY_SECRETS_GID=10001

# --- Networks -------------------------------------------------------------------
# Fixed names so Caddy's project, backups and metrics scrapers can attach.
TELEMETRY_DB_NETWORK=telemetry_db
TELEMETRY_EDGE_NETWORK=telemetry_edge
# Must not overlap any other Docker or host network. Dynamic addresses come from
# the ip_range; pin Caddy outside it (e.g. 10.247.81.2) to trust only Caddy.
TELEMETRY_EDGE_SUBNET=10.247.81.0/28
TELEMETRY_EDGE_IP_RANGE=10.247.81.8/29

# --- Collector --------------------------------------------------------------------
ALLOWED_ORIGINS=https://leangame.autumnofautumn.com
# Peers allowed to set the client IP header. Empty: the whole edge subnet (only
# Caddy and the collector attach to it). Once Caddy's edge address is pinned
# (docs/operations.md), narrow it to that address, e.g. 10.247.81.2/32.
TRUSTED_PROXY_CIDRS=
# Below the collector's 30 s stop_grace_period.
DRAIN_TIMEOUT_MS=20000
# Resource budget (docs/operations.md, "Resource budget").
COLLECTOR_MEMORY_LIMIT=640m
COLLECTOR_HEAP_MB=384
COLLECTOR_CPUS=2
# Admission and rate limits: docs/design.md section 3. Leave empty for the
# provisional defaults until the benchmark (docs/benchmark.md) sizes them.
PG_POOL_SIZE=
MAX_INFLIGHT_SUBMISSIONS=
QUEUE_MAX_REQUESTS=
QUEUE_MAX_EVENTS=
QUEUE_MAX_BYTES=
QUEUE_MAX_AGE_MS=
RATE_IP_REQUESTS_PER_MINUTE=
RATE_IP_EVENTS_PER_MINUTE=
RATE_USER_REQUESTS_PER_MINUTE=
RATE_USER_EVENTS_PER_MINUTE=
GLOBAL_REQUESTS_PER_SECOND=
GLOBAL_EVENTS_PER_SECOND=
GLOBAL_BYTES_PER_SECOND=
GLOBAL_FEEDBACK_PER_SECOND=
MICROBATCH_WINDOW_MS=
LATE_EVENT_MAX_AGE_DAYS=
# Other design.md section 3 variables (MAX_BODY_BYTES, BODY_TIMEOUT_MS,
# REQUEST_TIMEOUT_MS, STATEMENT_TIMEOUT_MS, ...) are passed through the same way.

# --- Disk watermarks (collector and compactor) ------------------------------------
# Empty volume on the same Docker data root as the database volume; set to a
# host path (bind mount) if PostgreSQL's data lives on another filesystem.
DISK_PROBE_SOURCE=disk_probe
DISK_ALERT_RATIO=0.70
DISK_THROTTLE_RATIO=0.80
DISK_PAUSE_RATIO=0.85

# --- PostgreSQL resources ---------------------------------------------------------
POSTGRES_MEMORY_LIMIT=4608m
POSTGRES_CPUS=3
POSTGRES_SHM_SIZE=256m
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_AUTOVACUUM_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_TEMP_FILE_LIMIT=4GB
POSTGRES_MAX_WAL_SIZE=2GB

# --- Compactor (profile "compactor"; docs/compaction.md) -----------------------
COMPACTION_MODE=shadow
COMPACTOR_MEMORY_LIMIT=384m
COMPACTOR_HEAP_MB=192
COMPACTOR_CPUS=1
COMPACTOR_PRESSURE_THRESHOLD=
COMPACTION_INACTIVE_SECONDS=
COMPACTION_MIN_AGE_SECONDS=
COMPACTION_ACTIVE_CHUNK_THRESHOLD=
COMPACTION_CHUNK_MAX_EVENTS=
COMPACTION_CHUNK_MAX_BYTES=
COMPACTION_REPLACE_DELAY_SECONDS=
COMPACTION_REPLACE_LIMIT=

# --- Tools (profile "tools") ----------------------------------------------------
# Writable by uid 1000; never inside a web root.
EXPORT_DIR=./exports
EXPORTER_HEAP_MB=256
# Retention stays a dry run until a recorded policy exists (docs/operations.md,
# "Retention policy"). Every window empty = keep everything.
RETENTION_POLICY_ID=
RETENTION_DETAIL_DAYS=
RETENTION_ATTEMPT_DAYS=
RETENTION_FEEDBACK_DAYS=
RETENTION_RECEIPT_DAYS=
# Required before RETENTION_DETAIL_DAYS / RETENTION_ATTEMPT_DAYS can delete: a
# verified archive directory (inside the retention container: /archive), or
# true to record that the policy accepts expiring the only copy.
RETENTION_ARCHIVE_DIR=
RETENTION_EXPIRE_LAST_COPY=false
# Host directory for archives (archive and retention services).
ARCHIVE_HOST_DIR=./archive

# --- Migration job ----------------------------------------------------------------
MIGRATION_LOCK_TIMEOUT_MS=
MIGRATION_DDL_LOCK_TIMEOUT_MS=
